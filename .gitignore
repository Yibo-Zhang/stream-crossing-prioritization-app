# Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class

# Compiled extensions
*.so
.Python

# Virtual environments
venv/
env/
ENV/
.venv/

# Build and distribution artifacts
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# IDE/editor settings
.vscode/
.idea/
*.swp
*.swo
*~

# Data files (keep structure, ignore actual data)
*.xlsx
*.xls
*.csv
data/input/*
data/output/*
!data/input/.gitkeep
!data/output/.gitkeep

# Beta v2: bundle the demo dataset and the committed baseline.
# These negations must come AFTER the data/input and *.csv rules above, or the
# broader rules win. The baseline is stored gzip-compressed so it is not caught
# by the *.csv rule; it is force-listed here for clarity.
!data/input/crossings.csv
!data/baseline/
!data/baseline/baseline_all.csv.gz
!data/baseline/baseline_manifest.json

# configs/metadata.csv holds the workbook header definitions and must be tracked
# despite the *.csv rule above.
!configs/metadata.csv

# Test coverage
.coverage
htmlcov/
.pytest_cache/

# OS files
.DS_Store
Thumbs.db

# Environment files
.env
.env.local
